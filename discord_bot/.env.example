# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# URLs to fetch game data (default values work for followerbattlegrounds.com)
GAME_HISTORY_URL=https://www.followerbattlegrounds.com/game_history_web.json
PLAYER_STATS_URL=https://www.followerbattlegrounds.com/player_statistics_web.json

# Cache refresh interval in minutes (default: 5)
CACHE_REFRESH_MINUTES=5
