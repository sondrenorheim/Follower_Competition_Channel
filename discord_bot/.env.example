# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Base URL for the partitioned API (set to your R2 public base or site root)
# Example: https://<your-r2-public-base>
API_BASE_URL=

# Optional local fallback (bot can read from disk if remote API is unavailable)
# Example: C:\Users\you\Documents\Follower_Competition_Channel\website\public
LOCAL_API_BASE=

# Cache refresh interval in minutes (default: 5)
CACHE_REFRESH_MINUTES=5
